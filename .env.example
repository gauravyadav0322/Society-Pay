SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=sqlite:///./societypay.db
# Optional SMTP for actual email delivery
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=SocietyPay <noreply@example.com>
SMTP_USE_TLS=true
ENABLE_SCHEDULER=true
# This project intentionally ships with mock payments only.
PAYMENT_MODE=mock
